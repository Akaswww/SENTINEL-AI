
# PostgreSQL
POSTGRES_PASSWORD=replace_with_secure_password

# Agent authentication
SENTINEL_AGENT_TOKEN=replace_with_secure_random_token

# Database configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=sentinel_db
DATABASE_USER=sentinel

# Dashboard authentication
SENTINEL_DASHBOARD_PASSWORD=replace_with_secure_password

# Development mode
SENTINEL_DEV_MODE=false
